---
const { title = 'SureForgeTech — Tools for software builders', description = 'Developer utilities, coding-agent tools, compliance automation, planning tools, and application platforms.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1018" />
    <title>{title}</title>
    <link rel="canonical" href={`https://sureforgetech.com${Astro.url.pathname}`} />
    <style is:global>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#edf2f8;background:#0b1018;font-synthesis:none;text-rendering:optimizeLegibility;--muted:#a6b2c2;--line:#263342;--accent:#72e0bc;--panel:#111a25}*{box-sizing:border-box}body{margin:0;line-height:1.6}a{color:inherit}a:focus-visible{outline:3px solid var(--accent);outline-offset:4px}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}.topbar{border-bottom:1px solid var(--line);background:#0b1018eF;position:sticky;top:0;z-index:2;backdrop-filter:blur(12px)}nav{height:72px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{font-weight:750;letter-spacing:-.04em;text-decoration:none;font-size:1.2rem}.brand span{color:var(--accent)}.navlinks{display:flex;gap:24px;align-items:center}.navlinks a{text-decoration:none;color:var(--muted);font-size:.92rem}.navlinks a:hover,.text-link:hover{color:var(--accent)}.hero{padding:100px 0 76px;max-width:880px}.eyebrow{color:var(--accent);font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;font-weight:700}.hero h1{font-size:clamp(3rem,8vw,6.4rem);line-height:.98;letter-spacing:-.075em;margin:20px 0 24px}.hero p{font-size:1.2rem;max-width:720px;color:var(--muted)}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.button{display:inline-flex;padding:11px 17px;border:1px solid #375246;border-radius:8px;background:#16352f;text-decoration:none;font-weight:650}.button.secondary{border-color:var(--line);background:transparent}.section{padding:48px 0 76px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:26px}.section h2{font-size:clamp(1.8rem,4vw,2.5rem);letter-spacing:-.05em;margin:0}.section-head p{margin:8px 0 0;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.card{border:1px solid var(--line);border-radius:12px;background:linear-gradient(145deg,#131d29,#0f1721);padding:22px;min-height:245px;display:flex;flex-direction:column}.card .category{font-size:.75rem;color:var(--accent);letter-spacing:.1em;text-transform:uppercase}.card h3{line-height:1.25;margin:12px 0 8px;font-size:1.2rem;letter-spacing:-.025em}.card p{color:var(--muted);font-size:.91rem;margin:0 0 18px}.meta{margin-top:auto;display:flex;justify-content:space-between;gap:10px;align-items:center;font-size:.78rem;color:#c6d0dd}.text-link{color:var(--accent);font-weight:650;text-decoration:none}.note{border-left:2px solid var(--accent);padding:4px 0 4px 18px;color:var(--muted);max-width:850px}.band{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#0e151e}.band-inner{padding:48px 0;display:grid;grid-template-columns:1fr 1fr;gap:40px}.band h2{letter-spacing:-.04em;margin:0 0 8px}.band p{color:var(--muted);margin:0}.footer{padding:34px 0 44px;color:var(--muted);font-size:.87rem}.footer-inner{display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}.footer a{color:#dbe4ee;text-decoration:none;margin-left:16px}.product-hero{padding:72px 0 38px}.product-hero h1{font-size:clamp(2.6rem,6vw,4.6rem);line-height:1.02;letter-spacing:-.07em;margin:12px 0}.product-hero .lead{font-size:1.17rem;color:var(--muted);max-width:780px}.detail{display:grid;grid-template-columns:minmax(0,2fr) minmax(220px,1fr);gap:42px;padding:24px 0 90px}.detail h2{letter-spacing:-.04em}.detail aside{border:1px solid var(--line);border-radius:12px;padding:20px;background:var(--panel);height:max-content}.detail aside p{color:var(--muted)}.plain{color:var(--muted)}.back{color:var(--accent);text-decoration:none}.draft{border:1px solid #725d32;background:#211c12;border-radius:9px;padding:14px 16px;color:#ecd49c}.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;background:#fff;color:#000;padding:10px;z-index:9}@media(max-width:850px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.wrap{width:min(100% - 28px,1120px)}nav{height:64px}.navlinks{gap:12px}.navlinks a{font-size:.82rem}.navlinks .optional{display:none}.hero{padding:76px 0 56px}.grid{grid-template-columns:1fr}.card{min-height:0}.section-head{display:block}.band-inner,.detail{grid-template-columns:1fr;gap:20px}}
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar"><div class="wrap"><nav aria-label="Main navigation"><a class="brand" href="/">SureForge<span>Tech</span></a><div class="navlinks"><a href="/#products">Products</a><a href="/docs/">Docs</a><a class="optional" href="/support/">Support</a><a class="optional" href="https://github.com/SureForgeTech">GitHub</a></div></nav></div></header>
    <main id="main"><slot /></main>
    <footer class="footer"><div class="wrap footer-inner"><div><strong>SureForgeTech</strong><br />Tools for software builders.</div><div><a href="/docs/">Documentation</a><a href="/support/">Support</a><a href="https://github.com/SureForgeTech">GitHub</a></div><div>© {new Date().getFullYear()} SureForgeTech</div></div></footer>
  </body>
</html>
