---
import '../styles/corporate.css';
const { title = 'SureForgeTech — Tools for people who build', description = 'Meet the SureForge family: practical apps, developer tools, and platforms for people who build software.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<meta name="theme-color" content="#073d32" />
<title>{title}</title>
<link rel="canonical" href={new URL(Astro.url.pathname, 'https://sureforgetech.com')} />
<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
<link rel="icon" sizes="any" href="/brand/favicon.ico" />
<link rel="apple-touch-icon" href="/brand/favicon-180.png" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={new URL(Astro.url.pathname, 'https://sureforgetech.com')} />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <nav class="shell navigation" aria-label="Main navigation">
      <a class="brand" href="/" aria-label="SureForgeTech home"><img src="/brand/logo-transparent.png" width="1774" height="887" alt="SureForgeTech"></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="navigation-links"><span></span><span></span><span class="sr-only">Menu</span></button>
      <div class="navigation-links" id="navigation-links">
        <a href="/#products">Products</a>
        <a href="/#about">Our approach</a>
        <a href="https://sureforgetech.com/docs/" target="_blank" rel="noopener">Documentation <span aria-hidden="true">↗</span></a>
        <a class="nav-github" href="https://github.com/SureForgeTech" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.3-4.3-2.2-6-2.7m12 5v-3.9a3.4 3.4 0 0 0-.9-2.7c3-.3 6.2-1.5 6.2-6.8A5.3 5.3 0 0 0 18.8 4c.2-.8.2-2-.2-3 0 0-1.1-.4-3.6 1.4a13.6 13.6 0 0 0-6 0C6.5.6 5.4 1 5.4 1 5 2 5 3.2 5.2 4a5.3 5.3 0 0 0-1.5 3.9c0 5.3 3.2 6.5 6.2 6.8a3.4 3.4 0 0 0-.9 2.7v3.9"/></svg>GitHub</a>
      </div>
    </nav>
  </header>

<main id="main"><slot /></main>
  <footer class="site-footer"><div class="shell footer-top"><div><a class="footer-brand" href="/">SureForgeTech</a><p>Tools for people who build.</p></div><div class="footer-links"><a href="/#products">Products</a><a href="https://sureforgetech.com/docs/" target="_blank" rel="noopener">Documentation</a><a href="https://github.com/SureForgeTech" target="_blank" rel="noopener">GitHub ↗</a></div></div><div class="shell footer-bottom"><span>© 2026 SureForgeTech</span><span>Made for real work.</span></div></footer>
<script>
const menuButton = document.querySelector('.menu-toggle');
const menu = document.querySelector('#navigation-links');
menuButton?.addEventListener('click', () => { const open = menu?.classList.toggle('open'); menuButton.setAttribute('aria-expanded', String(open)); });
const closeMenu = () => { menu?.classList.remove('open'); menuButton?.setAttribute('aria-expanded', 'false'); };
menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
document.addEventListener('keydown', event => { if (event.key === 'Escape') closeMenu(); });
</script>
</body>
</html>
