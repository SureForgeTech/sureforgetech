---
import SiteLayout from '../layouts/SiteLayout.astro';
import { products } from '../data/portfolio.js';
---
<SiteLayout>

    <section class="hero" id="top" aria-labelledby="hero-heading">
      <div class="shell hero-layout">
        <div class="hero-copy">
          <p class="eyebrow"><span class="small-rule"></span> THE SUREFORGE FAMILY</p>
          <h1 id="hero-heading">Tools for people<br>who <em>build.</em></h1>
          <p class="hero-lead">From your first AI-assisted project to your team’s next release. Practical software for building, planning, securing, and running what comes next.</p>
          <div class="hero-actions"><a class="button button-primary" href="#products">Meet the products <span aria-hidden="true">↗</span></a><a class="quiet-link" href="#about">Get to know SureForgeTech <span aria-hidden="true">→</span></a></div>
          <p class="hero-footnote">Native apps. Developer tools. Team platforms.</p>
        </div>
        <section class="hero-tools" aria-labelledby="hero-tools-heading">
          <h2 class="tools-heading" id="hero-tools-heading">Software for the work you do.</h2>
          <div class="tool-purpose">
            <div class="purpose-copy"><h3>Build with AI.</h3><p>Code and coordinate<br>across repositories.</p></div>
            <div class="purpose-apps">
              <button class="hero-product" data-product="sureforge" aria-label="Discover SureForge Agent"><span class="app-icon" style="--icon-x:17" aria-hidden="true"></span><span>Agent</span></button>
              <button class="hero-product" data-product="studio" aria-label="Discover SureForge Studio"><span class="app-icon" style="--icon-x:112" aria-hidden="true"></span><span>Studio</span></button>
            </div>
          </div>
          <div class="tool-purpose">
            <div class="purpose-copy"><h3>Test &amp; secure.</h3><p>Capture issues.<br>Organize security evidence.</p></div>
            <div class="purpose-apps">
              <button class="hero-product" data-product="bugnarrator" aria-label="Discover SureForge Capture"><span class="app-icon" style="--icon-x:403" aria-hidden="true"></span><span>Capture</span></button>
              <button class="hero-product" data-product="policyforge" aria-label="Discover SureForge Policy"><span class="app-icon" style="--icon-x:209" aria-hidden="true"></span><span>Policy</span></button>
            </div>
          </div>
          <div class="tool-purpose">
            <div class="purpose-copy"><h3>Connect &amp; run.</h3><p>Manage remote hosts.<br>Build multi-tenant apps.</p></div>
            <div class="purpose-apps">
              <button class="hero-product" data-product="terminal-workspace" aria-label="Discover SureForge Terminal"><span class="app-icon" style="--icon-x:501" aria-hidden="true"></span><span>Terminal</span></button>
              <button class="hero-product" data-product="flowforge" aria-label="Discover SureForge Flow"><span class="app-icon" style="--icon-x:799" aria-hidden="true"></span><span>Flow</span></button>
            </div>
          </div>
          <a class="tools-catalog-link" href="#products">Explore all nine products <span aria-hidden="true">↗</span></a>
        </section>
      </div>
    </section>

    <section class="portfolio" id="products" aria-labelledby="products-heading">
      <div class="shell">
        <div class="section-heading">
          <div><p class="eyebrow">NINE PRODUCTS. DISTINCT POSSIBILITIES.</p><h2 id="products-heading">Find your next tool.</h2></div>
          <p>Each with a clear purpose.<br> All part of the SureForge family.</p>
        </div>
        <div class="catalog-toolbar">
          <div class="filters" role="group" aria-label="Filter products">
            <button class="filter active" data-filter="all" aria-pressed="true">All products <span>9</span></button>
            <button class="filter" data-filter="build" aria-pressed="false">Build &amp; automate</button>
            <button class="filter" data-filter="team" aria-pressed="false">Plan &amp; secure</button>
            <button class="filter" data-filter="daily" aria-pressed="false">Everyday tools</button>
          </div>
          <p class="result-count" id="result-count" aria-live="polite">9 products</p>
        </div>
        <div class="product-grid" id="product-grid">{products.map(product => <article class="product-card" data-group={product.group} style={`--accent:${product.accent};--tint:${product.tint}`} aria-labelledby={`title-${product.id}`}>
<div class="product-card-main"><div class="card-top"><span class="app-icon" role="img" aria-label={`${product.name} app icon`} style={`--icon-x:${product.icon}`}></span><span class="product-status">{product.status}</span></div>
<p class="product-family">SUREFORGE</p><h3 id={`title-${product.id}`}>{product.name}</h3><p class="product-kind">{product.kind}</p><p class="product-description">{product.summary}</p></div>
<div class="product-card-footer"><span class="product-platform">{product.platform}</span><button class="explore-product" data-product={product.id} aria-label={`Explore SureForge ${product.name}`}>Explore <span aria-hidden="true">→</span></button></div>
</article>)}</div>
        <noscript><p>Browse <a href="/docs/">product documentation</a> for details about the SureForge family.</p></noscript>
        <p class="availability-note">A growing family, at different stages. Availability and licensing are shown for each product.</p>
      </div>
    </section>

    <section class="approach shell" id="about" aria-labelledby="about-heading">
      <div class="approach-title"><p class="eyebrow">INDEPENDENT TOOLS. A SHARED APPROACH.</p><h2 id="about-heading">Your workstation.<br>Your workflow.<br><em>Your next idea.</em></h2></div>
      <div class="approach-copy"><p class="large-copy">Good tools should make the work clearer.</p><p>SureForgeTech builds software for individual makers and engineering teams. Some tools live on your Mac. Others work inside the editor or planning system you already use. Some help you run applications on your own infrastructure.</p><p>The common thread is practical utility: a focused job, a clear workflow, and people in control.</p><div class="approach-links"><a href="https://sureforge.ai" target="_blank" rel="noopener">Explore SureForge.ai <span aria-hidden="true">↗</span></a><a href="https://github.com/SureForgeTech" target="_blank" rel="noopener">Find us on GitHub <span aria-hidden="true">↗</span></a></div></div>
    </section>

    <section class="resources" aria-labelledby="resources-heading">
      <div class="shell resources-layout"><div><p class="eyebrow">TAKE THE NEXT STEP</p><h2 id="resources-heading">Find your footing.<br>Then get building.</h2></div><div class="resource-links"><a href="https://sureforgetech.com/docs/" target="_blank" rel="noopener"><span><strong>Documentation</strong><small>Guides for the SureForge product family.</small></span><span aria-hidden="true">↗</span></a><a href="https://sureforgetech.com/support/" target="_blank" rel="noopener"><span><strong>Product support</strong><small>Find the right help for your workflow.</small></span><span aria-hidden="true">↗</span></a></div></div>
    </section>

  <dialog id="product-dialog" aria-labelledby="detail-title">
    <button class="dialog-close" aria-label="Close product details">×</button>
    <div class="detail-header"><span class="app-icon detail-icon" aria-hidden="true"></span><span class="detail-status"></span></div>
    <p class="product-family">SUREFORGE</p><h2 id="detail-title"></h2><p class="detail-kind"></p><p class="detail-description"></p>
    <dl class="detail-facts"><div><dt>Runs on</dt><dd class="detail-platform"></dd></div><div><dt>Availability / license</dt><dd class="detail-availability"></dd></div></dl>
    <p class="detail-note"></p>
    <div class="detail-actions"><a class="button button-primary detail-docs" target="_blank" rel="noopener">Documentation <span aria-hidden="true">↗</span></a><a class="quiet-link detail-page" target="_blank" rel="noopener">Product page <span aria-hidden="true">↗</span></a></div>
  </dialog>
<script>
import '../scripts/portfolio.js';
</script>
</SiteLayout>
